{
  "name": "@beiluol/knowflow-learning",
  "version": "0.2.0",
  "description": "KnowFlow Learning — 学习 / 复习 / 测验展示组件（纯 UI，不含 FSRS、记录与评分后端）",
  "type": "module",
  "license": "UNLICENSED",
  "keywords": [
    "vue",
    "vue3",
    "flashcard",
    "quiz",
    "spaced-repetition",
    "component-library"
  ],
  "sideEffects": [
    "**/*.css"
  ],
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./style.css": "./dist/style.css",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "pnpm run build:js && pnpm run build:types",
    "build:js": "vite build",
    "build:types": "vue-tsc -p tsconfig.build.json",
    "typecheck": "vue-tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "peerDependencies": {
    "@beiluol/knowflow-ui": "workspace:^0.2.0",
    "vue": "^3.4.0"
  },
  "devDependencies": {
    "@beiluol/knowflow-tokens": "workspace:*",
    "@beiluol/knowflow-ui": "workspace:*",
    "@vitejs/plugin-vue": "^6.0.7",
    "@vue/test-utils": "^2.5.0",
    "happy-dom": "^20.12.0",
    "typescript": "~6.0.2",
    "vite": "^8.1.1",
    "vitest": "^4.1.11",
    "vue": "^3.4.38",
    "vue-tsc": "^3.3.5"
  }
}
